# Copy to .env.registry on the NAS. Never commit real credentials or JWT keys.
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_REPOSITORY=vms
VMS_VERSION=v1.0.0
VMS_HTTP_PORT=18080
# Set your own key. Single quotes prevent dollar signs from being interpolated.
# When migrating an existing installation, keep its key to preserve login tokens.
VMS_SECRET_KEY='replace-with-your-existing-or-a-long-random-secret'
